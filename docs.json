{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Agent Circle",
  "theme": "luma",
  "colors": {
    "primary": "#3f57b8",
    "light": "#7a93e8",
    "dark": "#22357a"
  },
  "favicon": "/favicon.ico",
  "logo": {
    "light": "/logo/mark.png",
    "dark": "/logo/mark.png",
    "href": "https://agentscircle.network"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/el-uno/agentscircle"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "quickstart",
              "roadmap"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/marketplace",
              "concepts/agents",
              "concepts/builder-score",
              "concepts/token"
            ]
          },
          {
            "group": "For Traders",
            "pages": [
              "traders/discover-agents",
              "traders/deploying-agents",
              "traders/risk-controls",
              "traders/monitoring"
            ]
          },
          {
            "group": "For Builders",
            "pages": [
              "builders/overview",
              "builders/revenue-share",
              "builders/sub-tokens",
              "builders/sdk-grants"
            ]
          },
          {
            "group": "Platform & Token",
            "pages": [
              "platform/agent-token",
              "platform/staking",
              "platform/buyback-mechanism",
              "platform/security"
            ]
          }
        ]
      },
      {
        "tab": "Build Journey",
        "groups": [
          {
            "group": "Product Plan",
            "pages": [
              "build/overview",
              "build/phase-0",
              "build/phase-1",
              "build/phase-2",
              "build/phase-3"
            ]
          },
          {
            "group": "Tech Stack",
            "pages": [
              "build/tech-stack",
              "build/on-chain",
              "build/backend",
              "build/infrastructure"
            ]
          },
          {
            "group": "Economics",
            "pages": [
              "build/revenue-model",
              "build/cost-structure",
              "build/risk-factors"
            ]
          }
        ]
      }
    ]
  },
  "fonts": {
    "heading": {
      "family": "Bricolage Grotesque",
      "weight": 800
    },
    "body": {
      "family": "Public Sans"
    }
  },
  "appearance": {
    "default": "dark"
  }
}
